# Browser-safe Supabase project values. Never use the service_role key in Vite variables.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Enable only after the matching provider is configured in Supabase Auth.
VITE_AUTH_GOOGLE_ENABLED=false
VITE_AUTH_MICROSOFT_ENABLED=false
